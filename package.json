{
  "name": "family-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "dev:all": "concurrently -k \"npm run dev:worker\" \"npm run dev\"",
    "build": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build",
    "preview": "npm run build && wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply family_dashboard_db --local",
    "db:migrate:staging": "wrangler d1 migrations apply family_dashboard_db_staging --remote --env staging",
    "db:migrate:prod": "wrangler d1 migrations apply family_dashboard_db --remote",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy:prod": "npm run build && wrangler deploy",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.4",
    "wrangler": "^4.0.0"
  }
}
