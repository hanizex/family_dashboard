{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-dashboard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family_dashboard_db",
      "database_id": "2b05ae42-667e-48d1-bf69-a0c2579d25aa",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // Runs every 2 hours: materializes daily tasks + syncs Chess.com & Duolingo progress
    "crons": ["0 */2 * * *"]
  },
  "vars": {
    "APP_ENV": "production",
    "FAMILY_TIMEZONE": "Europe/Kyiv",
    "ALLOW_DEV_LOGIN": "false"
  },
  "env": {
    "staging": {
      "name": "family-dashboard-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "family_dashboard_db_staging",
          "database_id": "b7ed6f23-abef-4160-8669-dc04ceb7f3f9",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": {
        "crons": ["0 */2 * * *"]
      },
      "vars": {
        "APP_ENV": "staging",
        "FAMILY_TIMEZONE": "Europe/Kyiv",
        "ALLOW_DEV_LOGIN": "true"
      }
    }
  }
}
